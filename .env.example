# Copy to .env. Placeholders only: never commit real keys.

# 1 = demo mode: deterministic fake models, works offline, no key needed.
# 0 = live mode: real Gemini calls (gemini-3.5-flash-lite), needs GOOGLE_API_KEY. Costs money.
DEMO_MODE=1

# Live mode only: which model. gemini = gemini-3.5-flash-lite. gemma = the big hosted Gemma (gemma-4-31b-it), which is free
# with a Google API key but weaker with tools (see docs/getting-started.md). Both use GOOGLE_API_KEY.
LLM=gemini
GOOGLE_API_KEY=your-gemini-api-key
